{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run (CMake)",
      "type": "shell",
      "command": "cmake --build build --target run --config Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Debug (CMake)",
      "type": "shell",
      "command": "cmake --build build --target run --config Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": "cmake --build build --config Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: Build Release",
      "type": "shell",
      "command": "cmake --build build --config Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
